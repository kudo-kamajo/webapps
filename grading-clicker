        function generateMathQuestion() {
            const types = ['add', 'sub', 'mul', 'div'];
            const type = types[Math.floor(Math.random() * types.length)];
            let num1, num2, correctResult, opSymbol;

            if (type === 'add') {
                num1 = Math.floor(Math.random() * 89) + 10;
                num2 = Math.floor(Math.random() * 89) + 10;
                correctResult = num1 + num2;
                opSymbol = '＋';
            } else if (type === 'sub') {
                num1 = Math.floor(Math.random() * 89) + 10;
                num2 = Math.floor(Math.random() * (num1 - 1)) + 1;
                correctResult = num1 - num2;
                opSymbol = '－';
            } else if (type === 'mul') {
                num1 = Math.floor(Math.random() * 12) + 2;
                num2 = Math.floor(Math.random() * 12) + 2;
                correctResult = num1 * num2;
                opSymbol = '×';
            } else { // div
                num2 = Math.floor(Math.random() * 9) + 2;
                correctResult = Math.floor(Math.random() * 12) + 1;
                num1 = num2 * correctResult;
                opSymbol = '÷';
            }

            const expr = `${num1} ${opSymbol} ${num2} =`;
            
            let studentAns = correctResult;
            const isMistake = Math.random() < 0.35;
            if (isMistake) {
                const delta = (Math.floor(Math.random() * 4) + 1) * (Math.random() < 0.5 ? 1 : -1);
                studentAns = Math.max(0, correctResult + delta);
                if (studentAns === correctResult) studentAns += 1;
            }

            return {
                expr: expr,
                correctResult: correctResult,
                studentAns: studentAns,
                isCorrectAnswer: (studentAns === correctResult),
                userGraded: null,
                isPlayerCorrectGrading: null
            };
        }

