                const card = document.getElementById(`shop-card-${key}`);

                if (btn && costText && levelText && card) {
                    levelText.textContent = `Lv.${item.level}${item.maxLevel ? `/${item.maxLevel}` : ''}`;
                    costText.textContent = isMax ? 'MAX' : (!isAccuracyOk ? 'ロック中' : `${cost} 徳`);

                    if (isMax) {
                        btn.disabled = true;
                        btn.className = "shop-btn flex-shrink-0 px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm bg-slate-300 text-slate-600 cursor-default";
                        card.className = "bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-center justify-between gap-3 opacity-80";
                    } else if (!isAccuracyOk) {
                        btn.disabled = true;
                        btn.className = "shop-btn flex-shrink-0 px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm bg-red-200 text-red-600 cursor-not-allowed";
                        card.className = "bg-red-50/50 border border-red-200 rounded-xl p-3 flex items-center justify-between gap-3 opacity-75";
                    } else if (canAfford) {
                        btn.disabled = false;
                        btn.className = "shop-btn flex-shrink-0 px-4 py-2.5 rounded-xl font-bold text-xs shadow-md transition-all duration-150 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white cursor-pointer";
                        card.className = "bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-center justify-between gap-3 transition-colors hover:bg-amber-50/60 hover:border-amber-300";
                    } else {
                        btn.disabled = true;
                        btn.className = "shop-btn flex-shrink-0 px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm bg-slate-200 text-slate-400 cursor-not-allowed";
                        card.className = "bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-center justify-between gap-3 opacity-80";
                    }
                }
            });
        }

        function buyUpgrade(key) {
            const accuracy = state.totalGradingAttempts > 0 
                ? Math.round((state.totalCorrectGrading / state.totalGradingAttempts) * 100) 
                : 100;
            if (accuracy < 80) return;

            const item = state.upgrades[key];
            if (!item) return;

            const cost = Math.floor(item.basePrice * Math.pow(1.4, item.level));
            const isMax = item.maxLevel && item.level >= item.maxLevel;

            if (state.score >= cost && !isMax) {
                state.score -= cost;
                item.level++;

                if (key === 'redPen') {
                    state.ptsPerClick += 1;
                } else if (key === 'hanamaruStamp') {
                    state.autoPtsPerSec += 1;
                } else if (key === 'answerKey') {
                    state.answerKeyUnlocked = true;
                    renderPaper();
                } else if (key === 'autoReturnMachine') {
                    state.autoReturnUnlocked = true;
                }

                playSound('buy');
                renderShop(); // MAX到達時などの表示順ソート変更のために再描画
                updateUI();
            }
        }

        function updateUI() {
            document.getElementById('scoreDisplay').textContent = Math.floor(state.score).toLocaleString();
            document.getElementById('totalVirtueDisplay').textContent = Math.floor(state.totalVirtueEarned).toLocaleString();
            
            let totalPps = state.autoPtsPerSec;
            const assistantLevel = state.upgrades.gradingAssistant.level;
            if (assistantLevel > 0) {
                const interval = Math.max(0.5, 4.5 - (assistantLevel * 0.4));
                const assistantPps = Math.round((1 / interval) * state.ptsPerClick);
                totalPps += assistantPps;
            }

            document.getElementById('ppsDisplay').textContent = totalPps.toLocaleString();
            document.getElementById('returnedPapersDisplay').textContent = state.totalPapersReturned;
            document.getElementById('comboBadge').textContent = `COMBO x${state.combo}`;

            const accuracy = state.totalGradingAttempts > 0 
                ? Math.round((state.totalCorrectGrading / state.totalGradingAttempts) * 100) 
                : 100;
            document.getElementById('accuracyDisplay').textContent = `${accuracy}%`;

            updateShopButtons();
        }

        let assistantTimer = 0;
        setInterval(() => {
            if (state.autoPtsPerSec > 0) {
                const addVal = (state.autoPtsPerSec / 10);
                state.score += addVal;
                state.totalVirtueEarned += addVal;
                checkStoryProgression();
            }

            const assistantLevel = state.upgrades.gradingAssistant.level;
            const badgeEl = document.getElementById('assistantStatusBadge');
            
            if (assistantLevel > 0) {
                if (badgeEl) badgeEl.classList.remove('hidden');
                assistantTimer += 0.1;
                const interval = Math.max(0.5, 4.5 - (assistantLevel * 0.4));
                
                if (assistantTimer >= interval) {
                    assistantTimer = 0;
                    if (currentPaper.gradedCount < 10) {
                        const q = currentPaper.questions[currentPaper.currentIndex];
                        gradeCurrent(q.isCorrectAnswer, true);
                    }
                }
            } else {
                if (badgeEl) badgeEl.classList.add('hidden');
            }

            updateUI();
        }, 100);

        // キーボードショートカット
        window.addEventListener('keydown', (e) => {
            if (e.key === 'o' || e.key === 'O' || e.key === 'ArrowLeft') {
                gradeCurrent(true);
            } else if (e.key === 'x' || e.key === 'X' || e.key === 'ArrowRight') {
                gradeCurrent(false);
            } else if (e.key === 'Enter' || e.key === ' ') {
                if (currentPaper.gradedCount === 10) {
                    returnPaper();
                }
            }
        });

        window.onload = function() {
            renderShop();
            lucide.createIcons();
            createNewPaper();
            checkStoryProgression();
            updateUI();
            
            openHelpModal();
        };
    </script>
</body>
</html>
