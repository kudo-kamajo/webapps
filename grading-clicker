        function renderShop() {
            const shopList = document.getElementById('shopList');
            shopList.innerHTML = '';

            const keys = Object.keys(state.upgrades);
            
            // MAXレベル到達アイテムを末尾にしつつ、初期価格(basePrice)の昇順でソート
            keys.sort((a, b) => {
                const itemA = state.upgrades[a];
                const itemB = state.upgrades[b];
                const isMaxA = itemA.maxLevel && itemA.level >= itemA.maxLevel;
                const isMaxB = itemB.maxLevel && itemB.level >= itemB.maxLevel;

                if (isMaxA && !isMaxB) return 1;
                if (!isMaxA && isMaxB) return -1;
                return itemA.basePrice - itemB.basePrice;
            });

            keys.forEach(key => {
                const item = state.upgrades[key];
                const cost = Math.floor(item.basePrice * Math.pow(1.4, item.level));
                const isMax = item.maxLevel && item.level >= item.maxLevel;
                const canAfford = state.score >= cost && !isMax;

                const card = document.createElement('div');
