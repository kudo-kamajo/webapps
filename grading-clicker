<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小テスト採点マスター ～丸付けで徳を積みし者～</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kosugi+Maru&family=M+PLUS+Rounded+1c:wght@400;700;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'M PLUS Rounded 1c', 'Kosugi Maru', sans-serif;
            background-color: #f3f4f6;
            user-select: none;
        }
        .chalkboard {
            background-color: #1b4332;
            background-image: radial-gradient(#2d6a4f 1px, transparent 1px);
            background-size: 16px 16px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818;
            border: 12px solid #8d5b4c;
            transition: all 0.5s ease;
        }

        /* 徳に応じた黒板オーラエフェクト */
        .aura-ch2 {
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818, 0 0 15px rgba(52, 211, 153, 0.4);
        }
        .aura-ch3 {
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818, 0 0 25px rgba(251, 191, 36, 0.6);
            border-color: #a16207;
        }
        .aura-ch4 {
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818, 0 0 35px rgba(245, 158, 11, 0.9), 0 0 10px rgba(255, 255, 255, 0.8);
            border-color: #ca8a04;
        }
        .aura-ch5 {
            animation: pulse-god 2s infinite alternate;
            border-color: #eab308;
        }
        @keyframes pulse-god {
            0% { box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818, 0 0 30px rgba(234, 179, 8, 0.8); }
            100% { box-shadow: inset 0 0 20px rgba(0,0,0,0.6), 0 8px 0 #0d2818, 0 0 60px rgba(250, 204, 21, 1), 0 0 20px rgba(255, 255, 255, 1); }
        }

        .test-paper {
            background: #fffef0;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            background-image: linear-gradient(#e5e7eb 1px, transparent 1px);
            background-size: 100% 2.2rem;
        }
        .shop-btn {
            touch-action: manipulation;
        }
        .shop-btn * {
            pointer-events: none;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between">

    <header class="bg-red-600 text-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-white text-red-600 p-2 rounded-full font-black text-xl shadow">
                    <i data-lucide="edit-3"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-extrabold tracking-wider">小テスト採点マスター</h1>
                    <p class="text-xs text-red-100 hidden sm:block">～丸付けで徳を積みし者～</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <button id="helpBtn" onclick="openHelpModal()" class="p-2 bg-red-700 hover:bg-red-800 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1 transition">
                    <i data-lucide="help-circle"></i>
                    <span>遊び方</span>
                </button>
                <button id="soundToggleBtn" onclick="toggleSound()" class="p-2 bg-red-700 hover:bg-red-800 rounded-lg text-xs md:text-sm font-bold flex items-center gap-1 transition">
                    <i data-lucide="volume-2" id="soundIcon"></i>
                    <span id="soundStatus">SOUND: ON</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-3 md:p-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-6 flex-grow">
        
        <!-- 左側パネル: 採点エリアとステータス表示 -->
        <section class="lg:col-span-7 flex flex-col gap-4">
            
            <div id="chalkboardArea" class="chalkboard rounded-2xl p-4 md:p-6 text-white relative overflow-hidden">
                
                <!-- 称号 & 累計徳 & コンボバッジ -->
                <div class="flex flex-wrap justify-between items-center mb-2 pb-2 border-b border-emerald-600/40 gap-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs text-emerald-300 font-bold">【現在の称号】</span>
                        <span id="titleBadge" class="bg-amber-400 text-slate-900 px-3 py-0.5 rounded-full text-xs font-black shadow flex items-center gap-1">
                            <i data-lucide="award" class="w-3.5 h-3.5"></i>
                            <span id="titleText">駆け出し丸付け人</span>
                        </span>
                        <span class="text-xs text-emerald-200 font-bold bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-500/30">
                            通算獲得: <span id="totalVirtueDisplay" class="text-yellow-300 font-extrabold">0</span> 徳
                        </span>
                    </div>
                    <span id="comboBadge" class="bg-amber-400 text-slate-900 px-2.5 py-0.5 rounded-full text-xs font-black animate-pulse">
                        COMBO x1
                    </span>
                </div>
                
                <!-- 各種パラメータ -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center my-2">
                    <div class="bg-emerald-900/50 p-2 rounded-xl border border-emerald-500/30">
                        <span class="text-xs text-emerald-200 block">所持している徳</span>
                        <span id="scoreDisplay" class="text-xl md:text-2xl font-extrabold text-yellow-300">0</span>
                        <span class="text-[10px] text-emerald-300 block">徳</span>
                    </div>
                    <div class="bg-emerald-900/50 p-2 rounded-xl border border-emerald-500/30">
                        <span class="text-xs text-emerald-200 block">自動で積む徳</span>
                        <span id="ppsDisplay" class="text-xl md:text-2xl font-extrabold text-emerald-300">0</span>
                        <span class="text-[10px] text-emerald-300 block">徳/秒</span>
                    </div>
                    <div class="bg-emerald-900/50 p-2 rounded-xl border border-emerald-500/30">
                        <span class="text-xs text-emerald-200 block">返却済み答案</span>
                        <span id="returnedPapersDisplay" class="text-xl md:text-2xl font-extrabold text-sky-300">0</span>
                        <span class="text-[10px] text-emerald-300 block">枚</span>
                    </div>
                    <div class="bg-emerald-900/50 p-2 rounded-xl border border-emerald-500/30">
                        <span class="text-xs text-emerald-200 block">採点正確率</span>
                        <span id="accuracyDisplay" class="text-xl md:text-2xl font-extrabold text-pink-300">100%</span>
                        <span class="text-[10px] text-emerald-300 block">ミスに注意！</span>
                    </div>
                </div>

                <!-- 生徒のコメント吹き出しエリア（動的表示） -->
                <div id="studentCommentBox" class="hidden mt-3 bg-white/95 text-slate-800 p-2.5 rounded-xl shadow-lg text-xs font-bold flex items-center gap-2 border-2 border-amber-300 animate-bounce">
                    <div class="bg-amber-100 text-amber-700 p-1.5 rounded-full flex-shrink-0">
                        <i data-lucide="message-circle" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="text-[10px] text-amber-800 block font-normal">生徒の反応:</span>
                        <span id="studentCommentText">「先生、なんか今日の○いつもより綺麗で嬉しいです！」</span>
                    </div>
                </div>
            </div>

            <div id="testPaperCard" class="test-paper rounded-2xl border-2 border-amber-200/80 p-4 md:p-6 relative transition-all duration-300 transform">
                
                <!-- 用紙ヘッダー -->
                <div class="border-b-2 border-red-400 pb-3 mb-4 flex justify-between items-end">
                    <div>
                        <div class="text-xs text-red-500 font-bold tracking-wider">令和8年度 数学小テスト (中学計算)</div>
                        <h2 class="text-xl font-black text-slate-800">第 <span id="classNumberDisplay">1</span> 組 <span id="studentNumberDisplay">1</span> 番　計算力確認テスト</h2>
                    </div>
                    <div class="text-right border-2 border-red-500 rounded-xl px-3 py-1 bg-red-50/80">
                        <span class="text-[10px] text-red-600 block font-bold">生徒の得点</span>
                        <span id="paperScoreDisplay" class="text-2xl font-black text-red-600">--</span>
                        <span class="text-xs text-red-500 font-bold">/100</span>
                    </div>
                </div>

                <!-- 採点進行度バー -->
                <div class="mb-4">
                    <div class="flex justify-between text-xs font-bold text-slate-600 mb-1">
                        <span>採点進行度 (<span id="gradedCountDisplay">0</span> / 10問)</span>
                        <span id="paperStatusText" class="text-red-600">採点中...</span>
                    </div>
                    <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                        <div id="paperProgressBar" class="bg-red-500 h-2.5 rounded-full transition-all duration-200" style="width: 0%"></div>
                    </div>
                </div>

                <!-- 現在問題表示枠 -->
                <div id="activeQuestionArea" class="bg-amber-50/80 border-2 border-amber-300 rounded-2xl p-4 mb-4 text-center relative shadow-sm">
                    <div class="absolute -top-3 left-4 bg-amber-400 text-slate-900 text-xs font-black px-2 py-0.5 rounded-full flex items-center gap-1">
                        <span>採点中の問題</span>
                        <span id="assistantStatusBadge" class="hidden text-[10px] bg-emerald-700 text-white px-1.5 py-0.2 rounded-full font-normal">バイト待機中</span>
                    </div>
                    
                    <div class="text-xs text-slate-500 mb-1 font-bold">問題 <span id="currentQNum">1</span></div>
                    
                    <div class="flex items-center justify-center gap-3 text-2xl md:text-3xl font-extrabold text-slate-800 my-1">
                        <span id="currentExpr">7 + 8 =</span>
                        <span id="currentStudentAns" class="bg-white border-2 border-slate-400 px-3 py-1 rounded-xl text-indigo-700 shadow-inner">15</span>
                    </div>

                    <!-- 模範解答アシスト機能 -->
                    <div id="answerKeyHint" class="hidden text-xs font-bold text-emerald-600 mt-1 flex items-center justify-center gap-1">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        模範解答: <span id="correctAnswerValue" class="underline">15</span>
                        <span id="judgementHint" class="ml-2 font-black px-1.5 py-0.5 rounded text-white text-[10px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <button id="btnMaru" onclick="gradeCurrent(true)" class="group relative bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white font-extrabold py-4 px-6 rounded-2xl shadow-lg border-b-4 border-emerald-700 transition flex flex-col items-center justify-center gap-1">
                        <div class="flex items-center gap-2 text-2xl md:text-3xl">
                            <i data-lucide="circle" class="stroke-[3]"></i>
                            <span>正しい (○)</span>
                        </div>
                        <span class="text-[11px] bg-emerald-700/50 px-2 py-0.5 rounded-full text-emerald-100 font-normal">
                            [キー: O / ←]
                        </span>
                    </button>

                    <button id="btnBatsu" onclick="gradeCurrent(false)" class="group relative bg-indigo-500 hover:bg-indigo-600 active:scale-95 text-white font-extrabold py-4 px-6 rounded-2xl shadow-lg border-b-4 border-indigo-700 transition flex flex-col items-center justify-center gap-1">
                        <div class="flex items-center gap-2 text-2xl md:text-3xl">
                            <i data-lucide="x" class="stroke-[3]"></i>
                            <span>間違い (×)</span>
                        </div>
                        <span class="text-[11px] bg-indigo-700/50 px-2 py-0.5 rounded-full text-indigo-100 font-normal">
                            [キー: X / →]
                        </span>
                    </button>
                </div>

                <!-- 返却ボタン -->
                <button id="returnPaperBtn" disabled onclick="returnPaper()" class="w-full bg-slate-300 text-slate-500 font-black py-4 px-6 rounded-2xl shadow border-b-4 border-slate-400 cursor-not-allowed transition-all duration-200 flex items-center justify-center gap-2 text-lg">
                    <i data-lucide="send"></i>
                    <span id="returnBtnText">10問すべて採点してください</span>
                </button>

                <!-- 10問解答一覧 -->
                <div class="mt-6 border-t pt-4 border-slate-200">
                    <div class="text-xs font-bold text-slate-500 mb-2">【解答一覧】</div>
                    <div id="questionsGrid" class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs"></div>
                </div>

            </div>
        </section>

        <section class="lg:col-span-5 flex flex-col gap-4">
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-4 md:p-5 flex-grow flex flex-col">
                <div class="flex justify-between items-center border-b pb-3 mb-3">
                    <div class="flex items-center gap-2">
                        <div class="bg-amber-100 text-amber-700 p-2 rounded-xl">
                            <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-slate-800 text-lg">採点効率化ショップ</h3>
                            <p class="text-xs text-slate-500">徳を消費して採点を自動化＆効率化！</p>
                        </div>
                    </div>
                </div>

                <!-- 採点正確率警告メッセージ -->
                <div id="accuracyWarning" class="hidden mb-3 p-3 bg-red-100 border-2 border-red-400 rounded-xl text-red-700 text-xs font-bold flex items-center gap-2 animate-pulse">
                    <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0 text-red-600"></i>
                    <div>
                        <span class="font-black text-red-800 text-sm block">⚠️ 採点正確率が80%未満です！</span>
                        <span>正解率が低いためショップがロックされています。正確に丸付けを行い、正解率を80%以上に回復させてください。</span>
                    </div>
                </div>

                <!-- ショップアイテム一覧 -->
                <div id="shopList" class="flex flex-col gap-3 overflow-y-auto max-h-[600px] pr-1"></div>
            </div>
        </section>
    </main>

    <div id="welcomeModal" class="hidden fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl max-w-xl w-full p-6 text-slate-800 shadow-2xl border-4 border-amber-400 relative my-auto">
            
            <!-- モーダルヘッダー -->
            <div class="text-center mb-4">
                <div class="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-2 shadow-inner">
                    <i data-lucide="sparkles" class="w-7 h-7"></i>
                </div>
                <h2 class="text-2xl font-black text-slate-800">小テスト採点マスター</h2>
                <p class="text-xs text-red-600 font-bold">～丸付けで徳を積みし者～</p>
            </div>

            <!-- プロローグ -->
            <div class="bg-amber-50/80 border border-amber-200 rounded-2xl p-4 mb-4 text-xs leading-relaxed text-slate-700">
                <div class="font-extrabold text-amber-800 mb-1 flex items-center gap-1 text-sm">
                    <i data-lucide="book-open" class="w-4 h-4"></i>
                    <span>プロローグ：無限の小テストと「徳」</span>
                </div>
                <p>
                    舞台はとある中学校。数学担当のあなたのデスクには、毎日山のように積み上がる小テストの答案用紙……。定時退勤の夢が潰えかけたその時、あなたは気づく。
                    <br><span class="font-bold text-amber-900">「一枚一枚の答案に向き合い、正解に丸をつけ導く行為……これこそ世の中で最高の『徳を積む行為』なのでは！？」</span>
                    <br>その瞬間、あなたの手にある赤ペンが光を帯びた！
                </p>
            </div>

            <!-- ゲームの目的 -->
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 mb-4 text-xs">
                <div class="font-extrabold text-emerald-800 mb-1 flex items-center gap-1 text-sm">
                    <i data-lucide="target" class="w-4 h-4"></i>
                    <span>ゲームの目的</span>
                </div>
                <p class="text-slate-700 font-bold mb-1">
                    🎯 採点をして徳を積み、積んだ徳でアイテムを手に入れ、より徳を積もう！
                </p>
                <ul class="list-disc list-inside text-slate-600 space-y-1 pl-1">
                    <li>正確に丸付け（○/×）を行って答案を仕上げ、返却して一気に徳を獲得！</li>
                    <li>徳を使って「高級赤ペン」や「全自動返却機」等のショップアイテムを解放・強化！</li>
                    <li>徳を大量に獲得し、職員室の守護神から伝説の<b>『定時退勤の神』</b>を目指せ！</li>
                </ul>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-5">
                <div class="font-extrabold text-slate-800 mb-2 flex items-center gap-1 text-sm">
                    <i data-lucide="keyboard" class="w-4 h-4 text-indigo-600"></i>
                    <span>操作方法（キーボード対応）</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="bg-white p-2.5 rounded-xl border shadow-sm">
                        <div class="font-black text-emerald-600 text-sm mb-0.5">○ (正しい)</div>
                        <div class="font-mono bg-slate-100 rounded px-1 py-0.5 text-[11px] text-slate-700 font-bold border">O キー</div>
                        <div class="text-[10px] text-slate-400 mt-1">または [←] キー</div>
                    </div>
                    <div class="bg-white p-2.5 rounded-xl border shadow-sm">
                        <div class="font-black text-indigo-600 text-sm mb-0.5">× (間違い)</div>
                        <div class="font-mono bg-slate-100 rounded px-1 py-0.5 text-[11px] text-slate-700 font-bold border">X キー</div>
                        <div class="text-[10px] text-slate-400 mt-1">または [→] キー</div>
                    </div>
                    <div class="bg-white p-2.5 rounded-xl border shadow-sm">
                        <div class="font-black text-pink-600 text-sm mb-0.5">生徒へ返却</div>
                        <div class="font-mono bg-slate-100 rounded px-1 py-0.5 text-[11px] text-slate-700 font-bold border">Enter</div>
                        <div class="text-[10px] text-slate-400 mt-1">または [Space]</div>
                    </div>
                </div>
            </div>

            <!-- 開始ボタン -->
            <button onclick="closeWelcomeModal()" class="w-full bg-gradient-to-r from-red-500 to-pink-500 hover:brightness-110 text-white font-black py-3.5 px-6 rounded-2xl shadow-lg active:scale-95 transition text-base">
                採点を開始して徳を積む！
            </button>
        </div>
    </div>

    <div id="storyModal" class="hidden fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 text-center shadow-2xl border-4 border-amber-400 animate-fade-in relative">
            <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-3 shadow">
                <i data-lucide="sparkles" class="w-8 h-8"></i>
            </div>
            <div id="storyChapterTitle" class="text-xs font-black text-amber-600 tracking-wider">第1章：積徳の始まり</div>
            <h3 id="storyHeading" class="text-2xl font-black text-slate-800 my-1">徳の奇跡が起き始めた！</h3>
            <div id="storyBodyText" class="text-sm text-slate-600 my-4 leading-relaxed bg-slate-50 p-4 rounded-2xl text-left border">
                手作業で○×を重ねる中で、あなたは「徳」の存在を実感し始める。板書中のチョークが絶対に折れなくなり、赤ペンのインクも無限に湧き出しているようだ...
            </div>
            <button onclick="closeStoryModal()" class="w-full bg-gradient-to-r from-amber-500 to-amber-600 text-white font-extrabold py-3 px-6 rounded-2xl shadow-lg hover:brightness-110 active:scale-95 transition">
                徳の導きを進める
            </button>
        </div>
    </div>

    <footer class="bg-slate-800 text-slate-400 py-4 text-center text-xs mt-6 border-t border-slate-700">
        <p>小テスト採点マスター - Math Test Grading Clicker Game &copy; 2026</p>
        <p class="text-slate-500 mt-1">ショートカットキー: [O / ←] 正しい | [X / →] 間違い | [Enter / Space] 返却</p>
    </footer>

    <script>
        // ゲーム状態の管理
        let state = {
            score: 0,                   // 現在所持している「徳」
            totalVirtueEarned: 0,       // 通算（累計）で溜めた「徳」（ストーリー進行用）
            totalPapersReturned: 0,
            combo: 0,
            totalCorrectGrading: 0,
            totalGradingAttempts: 0,
            soundEnabled: true,
            classNum: 1,
            studentNum: 1,
            unlockedChapters: [],       // 解放済みストーリー章 [1, 2, 3, 4, 5]
            
            // アップグレードステータス
            ptsPerClick: 1,
            autoPtsPerSec: 0,
            autoReturnUnlocked: false,
            answerKeyUnlocked: false,

            upgrades: {
                redPen: { level: 0, basePrice: 20, name: "高級赤ペン", desc: "採点1回で積む徳 +1", icon: "pen-tool" },
                hanamaruStamp: { level: 0, basePrice: 150, name: "花まるスタンプ", desc: "自動で積む徳 +1 徳/秒", icon: "stamp" },
