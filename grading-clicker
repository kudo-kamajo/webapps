        function gradeCurrent(playerSaysCorrect, isAuto = false) {
            if (currentPaper.gradedCount >= 10) return;

            if (!isAuto) {
                assistantTimer = 0;
            }

            const q = currentPaper.questions[currentPaper.currentIndex];
            const isGradingCorrect = (playerSaysCorrect === q.isCorrectAnswer);

            q.userGraded = playerSaysCorrect ? 'maru' : 'batsu';
            q.isPlayerCorrectGrading = isGradingCorrect;

            state.totalGradingAttempts++;

            if (isGradingCorrect) {
                state.combo++;
                state.totalCorrectGrading++;
                playSound('maru');
                
                // 丸付けハイのレベルに応じたコンボ倍率計算
                const comboLevel = state.upgrades.comboBonus ? state.upgrades.comboBonus.level : 0;
                const comboRate = 0.1 + (comboLevel * 0.05); // 1Lvごとに+5%
                const maxComboMult = 3.0 + (comboLevel * 1.0); // 1Lvごとに最大倍率上限+100%
                
                const comboMultiplier = 1 + Math.min(state.combo * comboRate, maxComboMult);
                const earned = Math.round(state.ptsPerClick * comboMultiplier);
                
                addVirtue(earned);
                showFloatingText(isAuto ? `+${earned} 徳 (バイト)` : `+${earned} 徳`, playerSaysCorrect ? 'maru' : 'batsu');
            } else {
                state.combo = 0;
                playSound('batsu');
                showFloatingText(`ミス! コンボリセット`, 'batsu');
            }

            currentPaper.gradedCount++;
            currentPaper.currentIndex++;
            renderPaper();
        }

